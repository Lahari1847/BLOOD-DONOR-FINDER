# LifeLink Backend Environment Configuration
PORT=5001
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173

# Optional Third-Party Services (Fallback simulated if not supplied)
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=LifeLink Network <notifications@lifelink.org>
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
